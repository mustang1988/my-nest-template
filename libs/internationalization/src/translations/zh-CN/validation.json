{
  "IsIn": "$t(property.{property})应为为以下值之一: {constraints.0}",
  "IsInt": "$t(property.{property})应为整数",
  "IsEnum": "$t(property.{property})应为为以下值之一: {constraints.0}",
  "Length": "$t(property.{property})长度应在[{constraints.0}, {constraints.1}]范围内",
  "IsString": "$t(property.{property})应为字符串",
  "IsNotEmpty": "$t(property.{property})非空必填",
  "IsAudioValidator": "$t(property.{property})应为音频",
  "IsImageValidator": "$t(property.{property})应为图片",
  "IsVideoValidator": "$t(property.{property})应为视频",
  "IsSubtitleValidator": "$t(property.{property})应为字幕",
  "DurationValidator": "$t(property.{property})的时长应在[{constraints.0}, {constraints.1}]秒范围内",
  "MinDurationValidator": "$t(property.{property})时长应不小于{constraints.0}秒",
  "MaxDurationValidator": "$t(property.{property})时长应不大于{constraints.0}秒",
  "IsCodecValidator": "$t(property.{property})的$t(enum.ECodecType.{constraints.1})编码器应为{constraints.0}",
  "HeightValidator": "$t(property.{property})的画面高度应在[{constraints.0}, {constraints.1}]px范围内",
  "MinHeightValidator": "$t(property.{property})的画面高度应不小于{constraints.0}px",
  "MaxHeightValidator": "$t(property.{property})的画面高度应不大于{constraints.0}px",
  "WidthValidator": "$t(property.{property})的画面宽度应在[{constraints.0}, {constraints.1}]px范围内",
  "MinWidthValidator": "$t(property.{property})的画面宽度应不小于{constraints.0}px",
  "MaxWidthValidator": "$t(property.{property})的画面宽度应不大于{constraints.0}px",
  "AspectRatioValidator": "$t(property.{property})的画面宽高比应在[{constraints.0}, {constraints.1}]px范围内",
  "MinAspectRatioValidator": "$t(property.{property})的画面宽高比应不小于{constraints.0}",
  "MaxAspectRatioValidator": "$t(property.{property})的画面宽高比应不大于{constraints.0}",
  "FpsValidator": "$t(property.{property})的视频帧率应在[{constraints.0}, {constraints.1}]范围内",
  "MinFpsValidator": "$t(property.{property})的视频帧率应不小于{constraints.0}",
  "MaxFpsValidator": "$t(property.{property})的视频帧率应不大于{constraints.0}",
  "MediaSizeValidator": "$t(property.{property})的媒体文件大小应在[{constraints.0}, {constraints.1}]字节范围内",
  "MinMediaSizeValidator": "$t(property.{property})的媒体文件大小应不小于{constraints.0}字节",
  "MaxMediaSizeValidator": "$t(property.{property})的媒体文件大小应不大于{constraints.0}字节",
  "PixelsValidator": "$t(property.{property})的画面总像素数应在[{constraints.0}, {constraints.1}]范围内",
  "MinPixelsValidator": "$t(property.{property})的画面总像素数应不小于{constraints.0}",
  "MaxPixelsValidator": "$t(property.{property})的画面总像素数应不大于{constraints.0}"
}
