######################################################################################################################################################
# NestJS Template
######################################################################################################################################################

######################################################################################################################################################
# PM2配置
######################################################################################################################################################
# - PM2_WORKERS                                  : PM2工作进程数
#                                                  - 可选
#                                                  - 默认值: max (CPU逻辑核心数)
#                                                  - 值类型: 整数
#                                                  - 示例  : PM2_WORKERS=4
######################################################################################################################################################
PM2_WORKERS=1

######################################################################################################################################################
# 服务监听配置
######################################################################################################################################################
# - APP_TITLE                                    : 服务名称
#                                                  - 可选
#                                                  - 默认值: 空字符串
#                                                  - 值类型: 字符串
#                                                  - 示例  : APP_TITLE=Sample App
#                                                  - 注意  : 配置值包含'#'时需使用引号包裹配置值
#
# - APP_PORT                                     : 服务监听端口
#                                                  - 必须
#                                                  - 默认值: 无
#                                                  - 值类型: 整数
#                                                  - 示例  : APP_PORT=9001
#                                                  - 注意  : 容器环境下此配置值为容器内监听的端口, 需要在容器启动时映射容器外端口
######################################################################################################################################################
APP_TITLE=NestJS Template
APP_PORT=3000

######################################################################################################################################################
# 日志配置
######################################################################################################################################################
# - LOGGER_LEVEL                                 : 日志级别
#                                                  - 可选
#                                                  - 默认值: 'debug'
#                                                  - 值类型: 字符串枚举, 支持以下值之一: 'debug', 'info', 'warn', 'error'
#                                                  - 示例  : LOGGER_LEVEL=info
#
# - LOGGER_CONSOLE                               : 是否启用控制台日志
#                                                  - 可选
#                                                  - 默认值: false
#                                                  - 值类型: 布尔值
#                                                  - 示例  : LOGGER_CONSOLE=true
#                                                  - 注意  : 在容器环境下启用控制台日志, 随运行时间容器的磁盘占用会增长, 需要在容器启动时配置上限
#
# - LOGGER_MAX_SIZE                              : 单日志文件大小上限, 单日志文件大小达到此值时进行日志文件切分
#                                                  - 可选
#                                                  - 默认值: 2g
#                                                  - 值类型: 整数+单位尾缀组成的字符串, 支持以下单位尾缀: 'k', 'm', 'g'
#                                                  - 示例  : LOGGER_MAX_SIZE=500m
#
# - LOGGER_MAX_FILE                              : 日志文件保留数量上限, 日志文件按日期切分, 数量超过此值时滚动覆盖最早的日志文件
#                                                  - 可选
#                                                  - 默认值: 30d
#                                                  - 值类型: 整数或整数+尾缀'd'组成的字符串
#                                                    - 无尾缀'd'表示保留的日志文件'个数'
#                                                    - 有尾缀'd'表示保留的日志文件'天数'
#                                                  - 示例: LOGGER_MAX_FILE=90d
#
# - LOGGER_DIR                                   : 日志文件输出目录
#                                                  - 可选
#                                                  - 默认值: /tmp
#                                                  - 值类型: 目录绝对路径
#                                                  - 示例  : LOGGER_DIR=/root/.pm2/logs
#                                                  - 注意  : 容器环境下此配置值为容器内的目录, 需要在容器启动时映射容器外路径
#
# - LOGGER_JSON                                  : 是否输出JSON文件日志; 用于ELK等日志收集
#                                                  - 可选
#                                                  - 默认值: false
#                                                  - 值类型: 布尔值
#                                                  - 示例  : LOGGER_JSON=true
#
# - LOGGER_ZIP                                   : 是否对日志文件zip压缩
#                                                  - 可选
#                                                  - 默认值: true
#                                                  - 值类型: 布尔值
#                                                  - 示例  : LOGGER_ZIP=false
######################################################################################################################################################
LOGGER_LEVEL=debug
LOGGER_CONSOLE=true
LOGGER_MAX_SIZE=2g
LOGGER_MAX_FILE=30d
LOGGER_DIR=/tmp
LOGGER_JSON=true
LOGGER_ZIP=true

######################################################################################################################################################
# Redis配置
######################################################################################################################################################
# 默认Redis
######################################################################################################################################################
# - DEFAULT_REDIS_HOST                           : 默认Redis主机
#                                                  - 必填
#                                                  - 默认值: 无
#                                                  - 值类型: IP地址或可解析的域名
#                                                  - 示例  : DEFAULT_REDIS_HOST=192.168.11.21
#
# - DEFAULT_REDIS_PORT                           : 默认Redis端口
#                                                  - 可选
#                                                  - 默认值: 6379
#                                                  - 值类型: 整数
#                                                  - 示例  : DEFAULT_REDIS_PORT=6378
#
# - DEFAULT_REDIS_USERNAME                       : 默认Redis用户名
#                                                  - 可选
#                                                  - 默认值: 无
#                                                  - 值类型: 字符串
#                                                  - 示例  : DEFAULT_REDIS_USERNAME=user
#                                                  - 注意  : Redis启用了ACL认证时必须该配置项必须配置
#                                                  - 注意  : 配置值包含'#'时需使用引号包裹配置值
#
# - DEFAULT_REDIS_PASSWORD                       : 默认Redis密码
#                                                  - 可选
#                                                  - 默认值: 无
#                                                  - 值类型: 字符串
#                                                  - 示例  : DEFAULT_REDIS_PASSWORD=passw0rd@redis
#                                                  - 注意  : Redis启用了ACL认证或启用了requirepass时必须该配置项必须配置
#                                                  - 注意  : 配置值包含'#'时需使用引号包裹配置值
#
# - DEFAULT_REDIS_DB                             : 默认Redis库索引号
#                                                  - 可选
#                                                  - 默认值: 0
#                                                  - 值类型: 整数, 取值范围: [0, 15]
#                                                  - 示例  : DEFAULT_REDIS_DB=1
#
# - DEFAULT_REDIS_EVENT_CHANNEL                  : 默认Redis事件监听通道名称
#                                                  - 可选
#                                                  - 默认值: channel:default
#                                                  - 值类型: 字符串
#                                                  - 示例  : DEFAULT_REDIS_EVENT_CHANNEL=event-channel
#                                                  - 注意  : 配置值包含'#'时需使用引号包裹配置值
######################################################################################################################################################
DEFAULT_REDIS_HOST=127.0.0.1
DEFAULT_REDIS_PORT=6379
# DEFAULT_REDIS_USERNAME=
DEFAULT_REDIS_PASSWORD=dell_456
DEFAULT_REDIS_DB=0
DEFAULT_REDIS_EVENT_CHANNEL=channel:default

######################################################################################################################################################
# MySQL配置
######################################################################################################################################################
# 默认MySQL
######################################################################################################################################################
# - DEFAULT_MYSQL_HOST                           : 默认MySQL主机
#                                                  - 必填
#                                                  - 默认值: 无
#                                                  - 值类型: IP地址或可解析的域名
#                                                  - 示例  : DEFAULT_MYSQL_HOST=182.168.11.31
#
# - DEFAULT_MYSQL_PORT                           : 默认MySQL端口
#                                                  - 可选
#                                                  - 默认值: 3306
#                                                  - 值类型: 整数
#                                                  - 示例  : DEFAULT_MYSQL_PORT=3305
#
# - DEFAULT_MYSQL_USERNAME                       : 默认MySQL用户名
#                                                  - 必填
#                                                  - 默认值: 无
#                                                  - 值类型: 字符串
#                                                  - 示例  : DEFAULT_MYSQL_USERNAME=user
#                                                  - 注意  : 配置值包含'#'时需使用引号包裹配置值
#
# - DEFAULT_MYSQL_PASSWORD                       : 默认MySQL密码
#                                                  - 必填
#                                                  - 默认值: 无
#                                                  - 值类型: 字符串
#                                                  - 示例  : DEFAULT_MYSQL_PASSWORD=Pas$w0rd@MysQl
#                                                  - 注意  : 配置值包含'#'时需使用引号包裹配置值
#
# - DEFAULT_MYSQL_DATABASE                       : 默认MySQL数据库名
#                                                  - 必填
#                                                  - 默认值: 无
#                                                  - 值类型: 字符串
#                                                  - 示例  : DEFAULT_MYSQL_DATABASE=sample_database
#                                                  - 注意  : 服务启动前对应数据库需要先创建, 否则服务无法启动
#                                                  - 注意  : 配置值包含'#'时需使用引号包裹配置值
#
# - DEFAULT_MYSQL_CHARSET                        : 默认MySQL数据库字符集
#                                                  - 可选
#                                                  - 默认值: utf8mb4
#                                                  - 值类型: 字符串枚举, 支持以下值之一: 'utf8', 'utf8mb4'
#                                                  - 示例  : DEFAULT_MYSQL_CHARSET=utf8
#
# - DEFAULT_MYSQL_TIMEZONE                       : 默认MySQL时区
#                                                  - 可选
#                                                  - 默认值: +08:00
#                                                  - 值类型: UTC时间偏移量, 格式: +HH:MM
#                                                  - 示例  : DEFAULT_MYSQL_TIMEZONE=+00:00
#
# - DEFAULT_MYSQL_POOL_SIZE                      : 默认MySQL连接池大小
#                                                  - 可选
#                                                  - 默认值: 10
#                                                  - 值类型: 整数
#                                                  - 示例  : DEFAULT_MYSQL_POOL_SIZE=15
#
# - DEFAULT_MYSQL_LOGGER                         : 默认MySQL控制台日期开关, 开启后会在控制台输出执行的SQL
#                                                  - 可选
#                                                  - 默认值: false
#                                                  - 值类型: 布尔值
#                                                  - 示例  : DEFAULT_MYSQL_LOGGER=true
#
# - DEFAULT_MYSQL_SYNC                           : 默认MySQL表结构自动同步开关
#                                                  - 可选
#                                                  - 默认值: false
#                                                  - 值类型: 布尔值
#                                                  - 示例  : DEFAULT_MYSQL_SYNC=false
#                                                  - 注意: 生产环境下一定不要设置为true
######################################################################################################################################################
DEFAULT_MYSQL_HOST=127.0.0.1
DEFAULT_MYSQL_PORT=3306
DEFAULT_MYSQL_USERNAME=root
DEFAULT_MYSQL_PASSWORD=dell_456
DEFAULT_MYSQL_CHARSET=utf8mb4
DEFAULT_MYSQL_TIMEZONE=+08:00
DEFAULT_MYSQL_DATABASE=nestjs_template
DEFAULT_MYSQL_POOL_SIZE=10
DEFAULT_MYSQL_LOGGER=false
DEFAULT_MYSQL_SYNC=false

######################################################################################################################################################
# Rabbitmq配置
######################################################################################################################################################
# 默认Rabbitmq
######################################################################################################################################################
# - DEFAULT_RABBITMQ_HOST                        : 默认Rabbitmq主机
#                                                  - 必填
#                                                  - 默认值: 无
#                                                  - 值类型: IP地址或可解析的域名
#                                                  - 示例  : DEFAULT_RABBITMQ_HOST=172.16.23.206
#
# - DEFAULT_RABBITMQ_PORT                        : 默认Rabbitmq端口
#                                                  - 可选
#                                                  - 默认值: 5672
#                                                  - 值类型: 整数
#                                                  - 示例  : DEFAULT_RABBITMQ_PORT=5674
#
# - DEFAULT_RABBITMQ_USERNAME                    : 默认Rabbitmq用户名
#                                                  - 必填
#                                                  - 默认值: 无
#                                                  - 值类型: 字符串
#                                                  - 示例  : DEFAULT_RABBITMQ_USERNAME=user
#                                                  - 注意  : 配置值包含'#'时需使用引号包裹配置值
#
# - DEFAULT_RABBITMQ_PASSWORD                    : 默认Rabbitmq密码
#                                                  - 必填
#                                                  - 默认值: 无
#                                                  - 值类型: 字符串
#                                                  - 示例  : DEFAULT_RABBITMQ_PASSWORD=Pas$w0rd
#                                                  - 注意  : 配置值包含'#'时需使用引号包裹配置值
#
# - DEFAULT_RABBITMQ_VHOST                       : 默认Rabbitmq vhost
#                                                  - 可选
#                                                  - 默认值: ''
#                                                  - 值类型: 字符串
#                                                  - 示例  : DEFAULT_RABBITMQ_VHOST=sample
#                                                  - 注意  : 服务启动前对应vhost需要先创建, 否则服务无法启动
#                                                  - 注意  : 配置值包含'#'时需使用引号包裹配置值
#
# - DEFAULT_RABBITMQ_QUEUE                       : 默认Rabbitmq队列名称
#                                                  - 必填
#                                                  - 默认值: 无
#                                                  - 值类型: 字符串
#                                                  - 示例  : DEFAULT_RABBITMQ_QUEUE=queue-name
#                                                  - 注意  : 配置值包含'#'时需使用引号包裹配置值
#
# - DEFAULT_RABBITMQ_CONSUME                     : 默认Rabbitmq连接是否进行消费
#                                                  - 必填
#                                                  - 默认值: 无
#                                                  - 值类型: 布尔值
#                                                  - 示例  : DEFAULT_RABBITMQ_CONSUME=false
#
# - DEFAULT_RABBITMQ_PREFETCH_COUNT              : 默认Rabbitmq队列消费预取消息数量
#                                                  - 可选
#                                                  - 默认值: 无
#                                                  - 值类型: 整数
#                                                  - 示例  : DEFAULT_RABBITMQ_PREFETCH_COUNT=2
#
# - DEFAULT_RABBITMQ_AUTO_ACK                    : 默认Rabbitmq队列消息消费后是否自动ACK
#                                                  - 可选
#                                                  - 默认值: false
#                                                  - 值类型: 布尔值
#                                                    示例  : DEFAULT_RABBITMQ_AUTO_ACK=true
######################################################################################################################################################
DEFAULT_RABBITMQ_HOST=127.0.0.1
DEFAULT_RABBITMQ_PORT=5672
DEFAULT_RABBITMQ_USERNAME=root
DEFAULT_RABBITMQ_PASSWORD=dell_456
DEFAULT_RABBITMQ_VHOST=
DEFAULT_RABBITMQ_QUEUE=sample
DEFAULT_RABBITMQ_CONSUME=true
DEFAULT_RABBITMQ_AUTO_ACK=false

######################################################################################################################################################
# S3存储配置
######################################################################################################################################################
# 默认S3存储
######################################################################################################################################################
# - DEFAULT_S3_ENDPOINT                          : 默认S3存储服务接口接入点
#                                                  - 必填
#                                                  - 默认值: 无
#                                                  - 值类型: URL, 支持以下协议: http://, https://
#                                                  - 示例  : DEFAULT_S3_ENDPOINT=http://192.168.11.89:9000
#
# - DEFAULT_S3_REGION                            : 默认S3存储地区
#                                                  - 可选
#                                                  - 默认值: 'default'
#                                                  - 值类型: 字符串
#                                                  - 示例  : DEFAULT_S3_REGION=test
#                                                  - 注意  : 配置值包含'#'时需使用引号包裹配置值
#
# - DEFAULT_S3_ACCESS_KEY                        : 默认S3存储身份验证AccessKeyId, 由S3存储服务分配
#                                                  - 必填
#                                                  - 默认值: 无
#                                                  - 值类型: 字符串
#                                                  - 示例  : DEFAULT_S3_ACCESS_KEY=abcdef
#                                                  - 注意  : 配置值包含'#'时需使用引号包裹配置值
#
# - DEFAULT_S3_SECRET_KEY                        : 默认S3存储身份验证SecretAccessKey, 由S3存储服务分配
#                                                  - 必填
#                                                  - 默认值: 无
#                                                  - 值类型: 字符串
#                                                  - 示例  : DEFAULT_S3_SECRET_KEY=ghijk
#                                                  - 注意  : 配置值包含'#'时需使用引号包裹配置值
######################################################################################################################################################
DEFAULT_S3_ENDPOINT=http://10.50.2.35:9000
DEFAULT_S3_REGION=default
DEFAULT_S3_ACCESS_KEY=nx4L8cMhU418EcyfMkaU
DEFAULT_S3_SECRET_KEY=phXM28ggU37Oq7gzIrztdfSiL7F4YeTtSa8j4B1j


######################################################################################################################################################
# 国际化配置
######################################################################################################################################################
# - I18N_FALLBACK_LANGUAGE                       : 国际化回退语言
#                                                  - 可选
#                                                  - 默认值: en-US
#                                                  - 值类型: 字符串
#                                                  - 示例  : I18N_FALLBACK_LANGUAGE=zh-CN
#                                                  - 注意  : 配置值包含'#'时需使用引号包裹配置值
######################################################################################################################################################
I18N_FALLBACK_LANGUAGE=en-US

######################################################################################################################################################
# 密钥配置
######################################################################################################################################################
# - AES_KEY                                      : AES加密密钥
#                                                  - 必填
#                                                  - 默认值: 无
#                                                  - 值类型: 32字节长度的16进制字符串
#                                                  - 示例  : AES_KEY=ae73f4d8215aaffbded1e27d078e2cc19715d4be6d3b1b62780979ca1b22b39a
#                                                  - 注意  : 此配置在项目整个生命周期中不可以修改, 修改会导致已经存入数据库的加密字段值无法正确解密
#
# - AES_IV                                       : AES加密IV
#                                                  - 必填
#                                                  - 默认值: 无
#                                                  - 值类型: 16字节长度的16进制字符串
#                                                  - 示例  : AES_IV=40665856ff5127e4a3e8a8c4c300f405
#                                                  - 注意  : 此配置在项目整个生命周期中不可以修改, 修改会导致已经存入数据库的加密字段值无法正确解密
######################################################################################################################################################
AES_KEY=a149c772ffc9fa34de77c366a44d2304da0dde5f0aae2a9a02974bea47802f5c
AES_IV=d0411f3bae62ed658edb7a2cee79de92

######################################################################################################################################################
# 常量配置
######################################################################################################################################################
# - PERFORMANCE_THRESHOLD                        : 性能指标, 单位: 毫秒; 接口响应耗时大于此配置时, 会输出对应性能问题日志
#                                                  - 可选
#                                                  - 默认值: 100
#                                                  - 值类型: 整数
#                                                  - 示例  : PERFORMANCE_THRESHOLD=500
#
# - AXIOS_TIMEOUT_MS                             : 全局外部HTTP接口请求超时, 单位: 毫秒
#                                                  - 可选
#                                                  - 默认值: 300000(5分钟)
#                                                  - 值类型: 整数
#                                                  - 示例  : AXIOS_TIMEOUT_MS=10000
######################################################################################################################################################
PERFORMANCE_THRESHOLD=100
AXIOS_TIMEOUT_MS=300000