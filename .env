######################################################################################################################################################
# 国际化配置
######################################################################################################################################################
# - I18N_FALLBACK_LANGUAGE                       : 国际化回退语言
#                                                  - 可选
#                                                  - 默认值: en-US
#                                                  - 值类型: 字符串
#                                                  - 示例  : I18N_FALLBACK_LANGUAGE=zh-CN
#                                                  - 注意  : 配置值包含'#'时需使用引号包裹配置值
######################################################################################################################################################
I18N_FALLBACK_LANGUAGE=en-US

######################################################################################################################################################
# 密钥配置
######################################################################################################################################################
# - AES_KEY                                      : AES加密密钥
#                                                  - 必填
#                                                  - 默认值: 无
#                                                  - 值类型: 32字节长度的16进制字符串
#                                                  - 示例  : AES_KEY=ae73f4d8215aaffbded1e27d078e2cc19715d4be6d3b1b62780979ca1b22b39a
#                                                  - 注意  : 此配置在项目整个生命周期中不可以修改, 修改会导致已经存入数据库的加密字段值无法正确解密
#
# - AES_IV                                       : AES加密IV
#                                                  - 必填
#                                                  - 默认值: 无
#                                                  - 值类型: 16字节长度的16进制字符串
#                                                  - 示例  : AES_IV=40665856ff5127e4a3e8a8c4c300f405
#                                                  - 注意  : 此配置在项目整个生命周期中不可以修改, 修改会导致已经存入数据库的加密字段值无法正确解密
######################################################################################################################################################
AES_KEY=a149c772ffc9fa34de77c366a44d2304da0dde5f0aae2a9a02974bea47802f5c
AES_IV=d0411f3bae62ed658edb7a2cee79de92

######################################################################################################################################################
# 常量配置
######################################################################################################################################################
# - API_PERFORMANCE_THRESHOLD                    : 性能指标, 单位: 毫秒; 接口响应耗时大于此配置时, 会输出对应性能问题日志
#                                                  - 可选
#                                                  - 默认值: 100
#                                                  - 值类型: 整数
#                                                  - 示例  : PERFORMANCE_THRESHOLD=500
#
# - FUNCTION_PERFORMANCE_THRESHOLD               : 单函数执行性能指标, 单位: 毫秒; 单函数执行耗时大于此配置时, 会输出对应性能问题日志
#                                                  - 可选
#                                                  - 默认值: 50
#                                                  - 值类型: 整数
#                                                  - 示例  : FUNCTION_PERFORMANCE_THRESHOLD=40
#
# - AXIOS_TIMEOUT_MS                             : 全局外部HTTP接口请求超时, 单位: 毫秒
#                                                  - 可选
#                                                  - 默认值: 300000(5分钟)
#                                                  - 值类型: 整数
#                                                  - 示例  : AXIOS_TIMEOUT_MS=10000
#
# - MEDIA_READ_TIMEOUT_MS                        : 媒体信息读取超时, 单位: 毫秒
#                                                  - 可选
#                                                  - 默认值: 30000(30秒)
#                                                  - 值类型: 整数
#                                                  - 示例  : MEDIA_READ_TIMEOUT_MS=60000
#
# - MEDIA_READ_BUFFER_SIZE                       : 媒体信息读取缓冲区大小
#                                                  - 可选
#                                                  - 默认值: 10485760(10MB)
#                                                  - 值类型: 整数
#                                                  - 示例  : MEDIA_READ_BUFFER_SIZE=20971520
#
# - MEDIA_CACHE_SIZE                             : 媒体信息缓存大小
#                                                  - 可选
#                                                  - 默认值: 100
#                                                  - 值类型: 整数
#                                                  - 示例  : MEDIA_CACHE_SIZE=200     
######################################################################################################################################################
API_PERFORMANCE_THRESHOLD=100
FUNCTION_PERFORMANCE_THRESHOLD=50
AXIOS_TIMEOUT_MS=300000
MEDIA_READ_TIMEOUT_MS=30000
MEDIA_READ_BUFFER_SIZE=10485760
MEDIA_CACHE_SIZE=100