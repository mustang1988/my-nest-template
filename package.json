{
  "name": "my-nest-template",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "dotenv -e .env -- nest start --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "dotenv -e .env.unit-test -- jest --forceExit",
    "test:watch": "jest --watch",
    "test:cov": "dotenv -e .env.unit-test -- jest --coverage --forceExit",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@blazity/nest-file-fastify": "^1.0.0",
    "@fastify/compress": "^9.2.1",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.3",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/microservices": "^11.2.7",
    "@nestjs/platform-fastify": "^11.1.13",
    "@nestjs/platform-socket.io": "^11.2.5",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.2.5",
    "@redis/client": "^6.2.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.2.0",
    "bytes": "^3.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "json-bigint": "^1.0.0",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "ms": "^2.1.3",
    "mysql2": "^3.24.4",
    "nest-winston": "^2.0.0",
    "nestjs-cls": "^7.0.1",
    "nestjs-i18n": "^10.8.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "typeorm": "^1.1.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@compodoc/compodoc": "^2.0.0",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/bytes": "^3.1.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/json-bigint": "^1.0.4",
    "@types/lodash": "^4.17.25",
    "@types/luxon": "^3.7.6",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "axios": "^1.20.0",
    "dotenv-cli": "^11.0.0",
    "fastify": "^5.11.3",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "preset": "ts-jest",
    "rootDir": ".",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1"
    },
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testRegex": ".*\\.test\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t)s",
      "!src/main.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "<rootDir>/node_modules/(?!@faker-js/faker)"
    ]
  }
}
