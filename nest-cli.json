{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/my-nest-template/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "**/*.proto",
      "i18n/**/*",
      "**/*.pug",
      {
        "include": "internationalization/translations/**/*",
        "watchAssets": true
      }
    ],
    "watchAssets": true,
    "webpack": false,
    "tsConfigPath": "apps/my-nest-template/tsconfig.app.json"
  },
  "projects": {
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "configuration": {
      "type": "library",
      "root": "libs/configuration",
      "entryFile": "index",
      "sourceRoot": "libs/configuration/src",
      "compilerOptions": {
        "tsConfigPath": "libs/configuration/tsconfig.lib.json"
      }
    },
    "context": {
      "type": "library",
      "root": "libs/context",
      "entryFile": "index",
      "sourceRoot": "libs/context/src",
      "compilerOptions": {
        "tsConfigPath": "libs/context/tsconfig.lib.json"
      }
    },
    "event": {
      "type": "library",
      "root": "libs/event",
      "entryFile": "index",
      "sourceRoot": "libs/event/src",
      "compilerOptions": {
        "tsConfigPath": "libs/event/tsconfig.lib.json"
      }
    },
    "internationalization": {
      "type": "library",
      "root": "libs/internationalization",
      "entryFile": "index",
      "sourceRoot": "libs/internationalization/src",
      "compilerOptions": {
        "tsConfigPath": "libs/internationalization/tsconfig.lib.json"
      }
    },
    "logger": {
      "type": "library",
      "root": "libs/logger",
      "entryFile": "index",
      "sourceRoot": "libs/logger/src",
      "compilerOptions": {
        "tsConfigPath": "libs/logger/tsconfig.lib.json"
      }
    },
    "media": {
      "type": "library",
      "root": "libs/media",
      "entryFile": "index",
      "sourceRoot": "libs/media/src",
      "compilerOptions": {
        "tsConfigPath": "libs/media/tsconfig.lib.json"
      }
    },
    "my-nest-template": {
      "type": "application",
      "root": "apps/my-nest-template",
      "entryFile": "main",
      "sourceRoot": "apps/my-nest-template/src",
      "compilerOptions": {
        "tsConfigPath": "apps/my-nest-template/tsconfig.app.json"
      }
    },
    "mysql": {
      "type": "library",
      "root": "libs/mysql",
      "entryFile": "index",
      "sourceRoot": "libs/mysql/src",
      "compilerOptions": {
        "tsConfigPath": "libs/mysql/tsconfig.lib.json"
      }
    },
    "rabbitmq": {
      "type": "library",
      "root": "libs/rabbitmq",
      "entryFile": "index",
      "sourceRoot": "libs/rabbitmq/src",
      "compilerOptions": {
        "tsConfigPath": "libs/rabbitmq/tsconfig.lib.json"
      }
    },
    "redis": {
      "type": "library",
      "root": "libs/redis",
      "entryFile": "index",
      "sourceRoot": "libs/redis/src",
      "compilerOptions": {
        "tsConfigPath": "libs/redis/tsconfig.lib.json"
      }
    },
    "s3-storage": {
      "type": "library",
      "root": "libs/s3-storage",
      "entryFile": "index",
      "sourceRoot": "libs/s3-storage/src",
      "compilerOptions": {
        "tsConfigPath": "libs/s3-storage/tsconfig.lib.json"
      }
    },
    "sample": {
      "type": "application",
      "root": "apps/sample",
      "entryFile": "main",
      "sourceRoot": "apps/sample/src",
      "compilerOptions": {
        "tsConfigPath": "apps/sample/tsconfig.app.json"
      }
    },
    "websocket": {
      "type": "library",
      "root": "libs/websocket",
      "entryFile": "index",
      "sourceRoot": "libs/websocket/src",
      "compilerOptions": {
        "tsConfigPath": "libs/websocket/tsconfig.lib.json"
      }
    }
  },
  "monorepo": true,
  "root": "apps/my-nest-template"
}